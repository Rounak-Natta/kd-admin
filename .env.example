CONTROL_JWT_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
CONTROL_ADMIN_EMAIL=admin@example.com
CONTROL_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
